import { ref, watch } from 'vue'

export function useTheme() {
  const isLight = ref(false)

  const loadTheme = () => {
    const theme = localStorage.getItem('openosint-theme') || 'dark'
    isLight.value = theme === 'light'
    applyTheme()
  }

  const applyTheme = () => {
    if (isLight.value) {
      document.documentElement.classList.add('light')
      localStorage.setItem('openosint-theme', 'light')
    } else {
      document.documentElement.classList.remove('light')
      localStorage.setItem('openosint-theme', 'dark')
    }
  }

  const toggleTheme = () => {
    isLight.value = !isLight.value
    applyTheme()
  }

  watch(isLight, applyTheme)

  return {
    isLight,
    toggleTheme,
    loadTheme
  }
}